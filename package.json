{
  "name": "roblox-countdown-icon-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "dev": "node scripts/wrangler.js dev",
    "deploy": "node scripts/wrangler.js deploy",
    "check": "node scripts/wrangler.js deploy --dry-run --outdir dist",
    "register": "node --env-file=.dev.vars scripts/register-commands.js",
    "db:local": "node scripts/wrangler.js d1 migrations apply icon-countdown --local",
    "db:remote": "node scripts/wrangler.js d1 migrations apply icon-countdown --remote",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "prettier": "3.6.2",
    "wrangler": "^4.0.0"
  },
  "description": "Discord panel for scheduling Roblox experience icons on Cloudflare Workers.",
  "license": "UNLICENSED"
}
